# Generated by `stage worker service` (identity stage). `stage worker service start` may rewrite it;
# put local overrides in a drop-in: systemctl --user edit stage-worker.service
[Unit]
Description=Stage worker (stage)
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=notify
ExecStart=/usr/bin/stage worker run --managed
SyslogIdentifier=stage-worker
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
RestartPreventExitStatus=75 78
TimeoutStartSec=120s
TimeoutStopSec=30s

[Install]
WantedBy=default.target

[X-Stage]
Generator=stage-service
Schema=1
Exe=/usr/bin/stage
Role=worker
