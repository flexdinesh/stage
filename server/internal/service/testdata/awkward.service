# Generated by `stage service` (identity stage-dev). `stage service start` may rewrite it;
# put local overrides in a drop-in: systemctl --user edit stage-dev.service
[Unit]
Description=Stage server (stage-dev)
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=notify
ExecStart="/opt/My Apps/50%% off/$$HOME/st\"age" serve --managed
Environment="XDG_DATA_HOME=/home/u/my data"
Environment=XDG_CONFIG_HOME=/home/u/100%%
SyslogIdentifier=stage-dev
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
RestartPreventExitStatus=75 78
TimeoutStartSec=120s
TimeoutStopSec=110s

[Install]
WantedBy=default.target

[X-Stage]
Generator=stage-service
Schema=1
Exe=/opt/My Apps/50% off/$HOME/st"age
