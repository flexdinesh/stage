# Listen addresses, comma-separated: host:port, unix:/abs/path.sock (0660), or
# unix (the private per-user default socket, 0600). One process serves all.
# Default 127.0.0.1:7380 (localhost only: there is no auth). compose.yaml sets
# 0.0.0.0:7380 inside the container and publishes 127.0.0.1:7380 on the host.
# `stage serve --listen ADDR` (repeatable) overrides it. See docs/runtime.md.
# STAGE_LISTEN=127.0.0.1:7380
# STAGE_LISTEN=unix:/run/stage/stage.sock
# STAGE_LISTEN=unix,127.0.0.1:7380

# Public URL of the PWA, e.g. https://stage.example.com behind an HTTPS
# reverse proxy. Push and install need HTTPS; when it is https it is also the
# Web Push VAPID subject. Optional.
# STAGE_PUBLIC_URL=
# Its origin is trusted by the request-origin policy (Host/Origin checks).

# Extra trusted browser origins, comma-separated (http(s)://host[:port]): a
# reverse proxy hostname other than STAGE_PUBLIC_URL's (Tailscale serve, Caddy).
# Other hostnames get 403. Not authentication: see README, Security.
# STAGE_ALLOWED_ORIGINS=

# Let a foreground server run harnesses that are local processes (the managed
# service always may; the Docker image sets STAGE_MACHINE_PROFILE=container,
# which never may). Same as `stage serve --local-harnesses`. See docs/runtime.md.
# STAGE_LOCAL_HARNESSES=1

# SQLite data dir (holds stage.db). Default: $XDG_DATA_HOME/stage, else
# ~/.local/share/stage (macOS: ~/Library/Application Support/stage).
# compose.yaml sets /data (volume stagedata).
# STAGE_DATA_DIR=

# Harness connections (T3, OpenCode) are set in Settings > Connections, not
# here. Under compose, T3 on the Docker host is http://host.docker.internal:3773
# (T3 must listen beyond loopback).

# Optional. 1 = use an in-memory fake T3 (UI/dev without a T3 server)
T3_FAKE=
