# HTTP listen address
APP_HOST=0.0.0.0
APP_PORT=7380

# Public HTTPS URL of the PWA (Web Push VAPID subject; must be https://)
APP_PUBLIC_URL=https://stage.local.deebox.xyz

# Postgres (compose `db` service, published on 127.0.0.1:5439)
DATABASE_URL=postgres://stage:stage@127.0.0.1:5439/stage?sslmode=disable

# T3 Code: server-side URL (MCP/OAuth) and browser-facing URL ("Open in T3" links)
T3_URL=http://127.0.0.1:3773
T3_PUBLIC_URL=http://controlbox:3773

# Optional. Enables OAuth token auto-renew. Issue once on the T3 host:
# t3 auth session issue --ttl 3650d --label stage --scope access:write --scope orchestration:read --scope orchestration:operate --scope settings:write --scope source-control:write --token-only
T3_ADMIN_TOKEN=

# Optional. 1 = use an in-memory fake T3 (UI/dev without a T3 server)
T3_FAKE=
