# `mise run dev` loads .env.dev (never .env). STAGE_DATA_DIR is always the
# branch's dev dir (.scratch/dev/<branch>); it can't be set here.

# Dev server port (prod owns 7380). Vite proxies /api here.
APP_PORT=7390

# Dev talks to the real T3. Same values as prod's .env work.
T3_URL=http://127.0.0.1:3773
T3_PUBLIC_URL=http://controlbox:3773
T3_ADMIN_TOKEN=
