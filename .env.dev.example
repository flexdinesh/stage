# `mise run dev` loads .env.dev (never .env). STAGE_DATA_DIR is always the
# branch's dev dir (.scratch/dev/<branch>); it can't be set here.

# Dev server listen address (prod defaults to 127.0.0.1:7380). Vite proxies
# /api here. host:port or unix:/abs/path.sock.
STAGE_LISTEN=127.0.0.1:7390

# Each fresh dev database starts with no connections: pair T3 (default
# http://127.0.0.1:3773) in Settings > Connections, or use the fake T3.
# T3_FAKE=1
